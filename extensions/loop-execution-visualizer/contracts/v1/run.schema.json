{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "loop-execution-visualizer/v1/run",
  "title": "Projected run (v1)",
  "description": "The complete rebuildable projection served to the canvas and to loopviz_status. It is derived only from the immutable event log; it is a cache, never a source of truth.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "isoTime": { "type": "string", "format": "date-time", "minLength": 20, "maxLength": 32 },
    "nullableIso": { "anyOf": [{ "$ref": "#/$defs/isoTime" }, { "type": "null" }] },
    "nullableString": { "anyOf": [{ "type": "string", "maxLength": 65536 }, { "type": "null" }] },

    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "workflowState", "hostActivity", "session", "usage", "semantics", "timeline"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "workflowState": { "type": "string", "minLength": 1, "maxLength": 32 },
        "workflowReason": { "$ref": "#/$defs/nullableString" },
        "focus": { "$ref": "#/$defs/nullableString" },
        "waitingOnNodeIds": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/id" } },
        "hostActivity": { "type": "string", "minLength": 1, "maxLength": 32 },
        "hostActivityDetail": { "$ref": "#/$defs/nullableString" },
        "startedAt": { "$ref": "#/$defs/nullableIso" },
        "elapsedMs": { "type": "number", "minimum": 0 },
        "session": { "$ref": "dag.schema.json#/$defs/sessionRef" },
        "usage": { "$ref": "dag.schema.json#/$defs/usageRollup" },
        "semantics": { "$ref": "dag.schema.json#/$defs/semantics" },
        "timeline": { "type": "array", "maxItems": 500, "items": { "$ref": "dag.schema.json#/$defs/timelineEntry" } }
      }
    },

    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventsApplied", "quarantined", "rejected", "truncated"],
      "properties": {
        "eventsApplied": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "retentionDroppedEvents": { "type": "integer", "minimum": 0 },
        "notes": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 2000 } }
      }
    }
  },

  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "skill", "title", "state", "outcome",
    "createdAt", "updatedAt", "elapsedMs", "controller", "dag",
    "incidents", "outbox", "usage", "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "$ref": "#/$defs/id" },
    "skill": { "$ref": "#/$defs/id" },
    "skillVersion": { "$ref": "#/$defs/nullableString" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "projectId": { "$ref": "#/$defs/nullableString" },
    "repository": { "$ref": "#/$defs/nullableString" },
    "branch": { "$ref": "#/$defs/nullableString" },
    "state": { "type": "string", "minLength": 1, "maxLength": 32 },
    "outcome": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "reason", "at"],
          "properties": {
            "outcome": { "enum": ["completed", "failed", "canceled", "blocked"] },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "prUrl": { "$ref": "#/$defs/nullableString" },
            "at": { "$ref": "#/$defs/isoTime" }
          }
        }
      ]
    },
    "createdAt": { "$ref": "#/$defs/isoTime" },
    "updatedAt": { "$ref": "#/$defs/isoTime" },
    "elapsedMs": { "type": "number", "minimum": 0 },
    "controller": { "$ref": "#/$defs/controller" },
    "dag": { "$ref": "dag.schema.json#" },
    "incidents": { "$ref": "incident.schema.json#" },
    "outbox": { "$ref": "outbox.schema.json#" },
    "usage": { "$ref": "dag.schema.json#/$defs/usageRollup" },
    "priceSnapshots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshotId", "at", "unit"],
        "properties": {
          "snapshotId": { "$ref": "#/$defs/id" },
          "at": { "$ref": "#/$defs/isoTime" },
          "unit": { "enum": ["copilot_ai_credits", "provider_billed_currency"] },
          "currency": { "$ref": "#/$defs/nullableString" },
          "modelCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  }
}
