{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "loop-execution-visualizer/v1/dag",
  "title": "Projected DAG (v1)",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "nullableString": { "anyOf": [{ "type": "string", "maxLength": 65536 }, { "type": "null" }] },
    "isoTime": { "type": "string", "format": "date-time", "minLength": 20, "maxLength": 32 },
    "nullableIso": { "anyOf": [{ "$ref": "#/$defs/isoTime" }, { "type": "null" }] },

    "sessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appSessionId", "hostSessionId", "health", "activity"],
      "properties": {
        "appSessionId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "hostSessionId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "health": { "type": "string", "minLength": 1, "maxLength": 32 },
        "healthReason": { "$ref": "#/$defs/nullableString" },
        "activity": { "type": "string", "minLength": 1, "maxLength": 32 },
        "activityDetail": { "$ref": "#/$defs/nullableString" },
        "activitySince": { "$ref": "#/$defs/nullableIso" },
        "boundAt": { "$ref": "#/$defs/nullableIso" },
        "lastHeartbeatAt": { "$ref": "#/$defs/nullableIso" },
        "workingDirectory": { "$ref": "#/$defs/nullableString" }
      }
    },

    "usageRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "credits", "totalCredits", "tokens"],
      "properties": {
        "confidence": { "enum": ["actual", "estimated", "partial", "unavailable"] },
        "unit": { "enum": ["copilot_ai_credits", "provider_billed_currency"] },
        "currency": { "$ref": "#/$defs/nullableString" },
        "credits": { "type": "number", "minimum": 0 },
        "totalCredits": {
          "type": "number",
          "minimum": 0,
          "description": "Live sample credits plus the reconciliation remainder that no sample covered. This is the figure the UI shows, and it never double counts an observed sample."
        },
        "reconciledCredits": { "type": "number", "minimum": 0 },
        "unattributedCredits": { "type": "number", "minimum": 0 },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 },
            "cacheRead": { "type": "number", "minimum": 0 },
            "cacheWrite": { "type": "number", "minimum": 0 },
            "reasoning": { "type": "number", "minimum": 0 }
          }
        },
        "samples": { "type": "integer", "minimum": 0 },
        "blindWindows": { "type": "integer", "minimum": 0 }
      }
    },

    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/nullableString" },
        "prompt": { "$ref": "#/$defs/nullableString" },
        "plan": { "$ref": "#/$defs/nullableString" },
        "progress": { "$ref": "#/$defs/nullableString" },
        "details": { "$ref": "#/$defs/nullableString" },
        "artifacts": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 1024 } },
        "updatedAt": { "$ref": "#/$defs/nullableIso" }
      }
    },

    "timelineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "kind", "text"],
      "properties": {
        "at": { "$ref": "#/$defs/isoTime" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 32 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "authoritative": { "type": "boolean" }
      }
    },

    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "attemptNumber", "kind", "state", "startedAt", "session", "usage", "semantics", "timeline"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/id" },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["initial", "retry", "replacement", "recovery"] },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "stateReason": { "$ref": "#/$defs/nullableString" },
        "authoritativeFailure": { "type": "boolean" },
        "expected": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statuses", "sequence", "satisfied", "satisfiedAt", "satisfiedBy"],
              "properties": {
                "statuses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": { "type": "string", "minLength": 1, "maxLength": 64 }
                },
                "sequence": { "type": ["integer", "null"], "minimum": 0 },
                "satisfied": { "type": "boolean" },
                "satisfiedAt": { "$ref": "#/$defs/nullableIso" },
                "satisfiedBy": { "$ref": "#/$defs/nullableString" }
              }
            }
          ]
        },
        "startedAt": { "$ref": "#/$defs/isoTime" },
        "endedAt": { "$ref": "#/$defs/nullableIso" },
        "elapsedMs": { "type": "number", "minimum": 0 },
        "model": { "$ref": "#/$defs/nullableString" },
        "session": { "$ref": "#/$defs/sessionRef" },
        "usage": { "$ref": "#/$defs/usageRollup" },
        "semantics": { "$ref": "#/$defs/semantics" },
        "timeline": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/timelineEntry" } }
      }
    },

    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "dependsOn", "state", "planned", "attempts", "usage", "column"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "phase": { "$ref": "#/$defs/nullableString" },
        "role": { "type": "string", "minLength": 1, "maxLength": 32 },
        "dependsOn": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id" } },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "stateReason": { "$ref": "#/$defs/nullableString" },
        "planned": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "addedDuringRun": { "type": "boolean" },
        "addedReason": { "$ref": "#/$defs/nullableString" },
        "replacesNodeId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "startedAt": { "$ref": "#/$defs/nullableIso" },
        "endedAt": { "$ref": "#/$defs/nullableIso" },
        "elapsedMs": { "type": "number", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/attempt" } },
        "usage": { "$ref": "#/$defs/usageRollup" }
      }
    },

    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "addedDuringRun": { "type": "boolean" }
      }
    },

    "topologyIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": { "enum": ["cycle", "unknown_dependency", "duplicate_node", "attempt_before_topology", "self_dependency", "orphan_reference"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "nodeIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id" } }
      }
    }
  },

  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges", "columns", "issues"],
  "properties": {
    "nodes": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/edge" } },
    "columns": { "type": "integer", "minimum": 0 },
    "issues": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/topologyIssue" } }
  }
}
