{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "loop-execution-visualizer/v1/outbox",
  "title": "Projected outbox message (v1)",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "isoTime": { "type": "string", "format": "date-time", "minLength": 20, "maxLength": 32 },
    "nullableIso": { "anyOf": [{ "$ref": "#/$defs/isoTime" }, { "type": "null" }] },
    "nullableString": { "anyOf": [{ "type": "string", "maxLength": 65536 }, { "type": "null" }] },

    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "targetAppSessionId", "body", "bodyChecksum", "state", "queuedAt", "expiresAt", "attempts", "grantsNoAuthority", "history", "terminal"],
      "properties": {
        "messageId": { "$ref": "#/$defs/id" },
        "targetAppSessionId": { "$ref": "#/$defs/id" },
        "targetNodeId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "body": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "bodyChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "state": { "type": "string", "minLength": 1, "maxLength": 32 },
        "stateReason": { "$ref": "#/$defs/nullableString" },
        "grantsNoAuthority": {
          "type": "array",
          "description": "Authorities a queued message can never confer. Present on every message so no consumer can render one without it.",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "terminal": { "type": "boolean" },
        "queuedAt": { "$ref": "#/$defs/isoTime" },
        "expiresAt": { "$ref": "#/$defs/isoTime" },
        "deliveredAt": { "$ref": "#/$defs/nullableIso" },
        "settledAt": { "$ref": "#/$defs/nullableIso" },
        "attempts": { "type": "integer", "minimum": 0 },
        "history": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "state", "reason"],
            "properties": {
              "at": { "$ref": "#/$defs/isoTime" },
              "state": { "type": "string", "minLength": 1, "maxLength": 32 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "attempt": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },

  "type": "array",
  "maxItems": 512,
  "items": { "$ref": "#/$defs/message" }
}
