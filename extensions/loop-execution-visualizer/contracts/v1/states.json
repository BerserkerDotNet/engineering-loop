      "failed",
      "skipped",
      "canceled",
      "replaced"
    ],
    "waiting": [
      "waiting_input",
      "waiting_approval"
    ],
    "callerDirected": true,
    "transitions": {
      "pending": [
        "creating_queued",
        "ready",
        "running",
        "waiting_input",
        "waiting_approval",
        "blocked",
        "skipped",
