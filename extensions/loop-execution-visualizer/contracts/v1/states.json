    "labels": {
      "pending": "Not started",
      "creating_queued": "Creating/queued",
      "ready": "Ready",
      "running": "In progress",
      "waiting_input": "Waiting for input",
      "waiting_approval": "Waiting for approval",
      "blocked": "Blocked",
      "succeeded": "Completed",
      "failed": "Failed",
      "skipped": "Skipped",
      "canceled": "Cancelled",
      "replaced": "Superseded"
    },
    "note": "PRD FR2 requires one unambiguous displayed state per block, and separates waiting for input from waiting for approval; the two waits are therefore distinct states, never one generic 'waiting'. `labels` is the single source of the displayed wording so no renderer invents its own. A logical node is 'settled' when it reaches succeeded/failed/skipped/canceled, but only 'replaced' is truly terminal: retries and replacements are recorded as new attempts on the same logical node and legitimately re-enter running.",
    "tones": {
      "pending": "neutral",
      "creating_queued": "neutral",
      "ready": "ok",
      "running": "active",
      "waiting_input": "warn",
      "waiting_approval": "warn",
      "blocked": "warn",
      "succeeded": "ok",
      "failed": "bad",
      "skipped": "neutral",
      "canceled": "neutral",
      "replaced": "neutral"
    }
  },
