{
  "$id": "loop-execution-visualizer/v1/states",
  "version": "1",
  "description": "Normative state vocabularies and transitions. Every state machine in the visualizer is defined here once; per-skill duplication of these rules is forbidden and is rejected by the coverage validator.",
  "terminalEnvelopeStates": {
    "COMPLETE": { "node": "succeeded", "attempt": "succeeded" },
    "CRITIQUE_COMPLETE": { "node": "succeeded", "attempt": "succeeded" },
    "CRITIQUE_ADDRESSED": { "node": "succeeded", "attempt": "succeeded" },
    "REFINED": { "node": "succeeded", "attempt": "succeeded" },
    "IMPLEMENTATION_VALIDATED": { "node": "succeeded", "attempt": "succeeded" },
    "PR_CREATED": { "node": "succeeded", "attempt": "succeeded" },
    "RETRO_COMPLETE": { "node": "succeeded", "attempt": "succeeded" },
    "BLOCKED": { "node": "failed", "attempt": "failed" }
  },
  "run": {
    "states": [
      "declared",
      "running",
      "blocked",
      "completed",
      "failed",
      "canceled"
    ],
    "initial": "declared",
    "terminal": [
      "completed",
      "failed",
      "canceled"
    ],
    "callerDirected": true,
    "transitions": {
      "declared": [
        "running",
        "blocked",
        "completed",
        "failed",
        "canceled"
      ],
      "running": [
        "running",
        "blocked",
        "completed",
        "failed",
        "canceled"
      ],
      "blocked": [
        "running",
        "blocked",
        "completed",
        "failed",
        "canceled"
      ],
      "completed": [],
      "failed": [],
      "canceled": []
    },
    "authority": {
      "terminalRequires": "orchestrator_control",
      "note": "Only an orchestrator-authoritative run.outcome may move a run to a terminal state. Host idle, end-of-turn, session end and heartbeat loss must never do so. Every non-terminal state can reach every terminal state, so an authoritative outcome is never dropped for want of a transition."
    }
  },
  "node": {
    "states": [
      "pending",
      "creating_queued",
      "ready",
      "running",
      "waiting_input",
      "waiting_approval",
      "blocked",
      "succeeded",
      "failed",
      "skipped",
