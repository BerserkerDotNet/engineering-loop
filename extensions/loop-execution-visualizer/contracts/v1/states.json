        "succeeded",
        "failed",
        "canceled",
        "replaced"
      ],
      "blocked": [
        "ready",
        "running",
        "waiting_input",
        "waiting_approval",
        "succeeded",
        "failed",
        "canceled",
        "replaced"
      ],
      "succeeded": [
        "running",
        "waiting_input",
        "waiting_approval",
        "replaced"
      ],
      "failed": [
        "running",
        "waiting_input",
        "waiting_approval",
        "succeeded",
        "replaced"
