    "authoritativeFailureSignals": [
      "session.lifecycle:end:error",
      "session.lifecycle:error",
      "session.lifecycle:shutdown",
      "attempt.state:failed"
    ],
    "note": "Only the listed authoritative signals may fail an attempt. Missing heartbeats, host idle and end-of-turn must not. `session.lifecycle:error` is authoritative only when the host reported the error as non-recoverable.",
    "tones": {
      "pending": "neutral",
      "creating_queued": "neutral",
      "running": "active",
      "waiting_input": "warn",
      "waiting_approval": "warn",
      "succeeded": "ok",
      "failed": "bad",
      "canceled": "neutral",
      "abandoned": "neutral"
