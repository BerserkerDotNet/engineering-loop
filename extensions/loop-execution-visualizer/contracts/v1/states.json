    "labels": {
      "pending": "Not started",
      "creating_queued": "Creating/queued",
      "running": "In progress",
      "waiting_input": "Waiting for input",
      "waiting_approval": "Waiting for approval",
      "succeeded": "Completed",
      "failed": "Failed",
      "canceled": "Cancelled",
      "abandoned": "Abandoned"
